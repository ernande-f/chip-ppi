NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://chip:CHANGE_ME@127.0.0.1:5432/chip
DATABASE_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:3000
APP_SESSION_SECRET=USE_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_ALLOWED_DOMAINS=aluno.iffar.edu.br,iffarroupilha.edu.br
# Produção com Nginx na mesma máquina: NODE_ENV=production,
# APP_URL=https://chip.SEU_DOMINIO e TRUST_PROXY=loopback.
# Sem proxy, mantenha false.
TRUST_PROXY=false
GLOBAL_RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=20
